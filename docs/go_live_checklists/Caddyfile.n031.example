erp.example.com {
    encode gzip

    reverse_proxy 127.0.0.1:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}

        health_uri /api/health
        health_interval 10s
        health_timeout 3s
    }

    log {
        output file C:\erp\logs\caddy-access.log
    }
}
