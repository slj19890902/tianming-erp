+def backup_workspace_budget(shared, *, kind):
+    """Conservative temporary-space upper bound; never substitute cleanup target.
+
+    Six DB/WAL-sized allocations cover snapshot, raw/encrypted/readback ZIP,
+    verified extraction and durable output. Paired objects reserve all originals
+    as new plus the largest encrypt/readback pair. No reuse discount is assumed.
+    """
+    from desktop_assistant import data_recovery
+    shared = Path(shared)
+    db = shared / data_recovery.DATABASE
+    if db.is_symlink() or not db.is_file():
+        raise ValueError('Snapshot source must be a real database file')
+    db_bytes = db.stat().st_size
+    wal = db.with_name(db.name + '-wal')
+    if wal.exists():
+        if wal.is_symlink() or not wal.is_file():
+            raise ValueError('Unsafe snapshot WAL')
+        db_bytes += wal.stat().st_size
+    files = file_points.fingerprint(shared)
+    amounts = [v[2] for v in files.values()]
+    total = sum(amounts)
+    largest = max(amounts, default=0)
+    if kind not in ('database', 'data'):
+        raise ValueError('Unknown snapshot kind')
+    workspace = (6 * db_bytes + (2 * total + 2 * largest if kind == 'database' else 6 * total)
+                 + 1024**3 + 16 * 1024**2)
+    return dict(database_and_wal_bytes=db_bytes, business_file_count=len(amounts),
+                business_file_bytes=total, temporary_budget_bytes=workspace)
+
